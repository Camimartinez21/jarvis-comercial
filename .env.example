# Variables de la agente. En Railway van como variables SELLADAS (ícono de candado).
# En tu PC, el archivo .env (nunca en git) solo guarda AGENTE_API_TOKEN para pruebas locales.

# --- Modelo (DeepSeek, saldo prepago = tope de gasto) ---
DEEPSEEK_API_KEY=              # platform.deepseek.com › API keys

# --- Telegram: solo Cami ---
TELEGRAM_BOT_TOKEN=            # @BotFather › /newbot
TELEGRAM_ALLOWED_USERS=        # Tu ID numérico de Telegram (de @userinfobot). Solo el tuyo.
TELEGRAM_HOME_CHANNEL=         # El mismo ID: ahí llegan los trabajos programados.

# --- Business OS (agente-api) ---
AGENTE_API_URL=https://iqdpjvramnwcasanjxhz.supabase.co/functions/v1/agente-api
AGENTE_API_TOKEN=              # La llave de la agente (está en tu .env local; se copia a Railway)

# --- Comportamiento ---
HERMES_TIMEZONE=America/Santiago
JARVIS_AUTOPILOT_DAILY_USD=0.30
JARVIS_LEARN_CHANNELS=telegram
JARVIS_STT_CLOUD=off
